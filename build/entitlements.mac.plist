<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron apps need these two under the hardened runtime so the V8 JIT works. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Allow loading the bundled native addons (sherpa-onnx, libnut) that are not
       signed by Apple. Required for the voice/computer-control features. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Runtime device access. macOS still shows its own permission prompts. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <!-- Lets ZVYRA automate and control other apps (Apple Events), with user approval. -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
