{
  "name": "zvyra-ios",
  "productName": "ZVYRA",
  "version": "0.1.0",
  "description": "Standalone iOS build of ZVYRA — the same UI and animations as the desktop app, running on a browser-safe in-memory preview adapter inside Capacitor.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cap:add:ios": "cap add ios",
    "cap:sync": "cap sync ios",
    "cap:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "7.4.3",
    "@capacitor/ios": "7.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "lucide-react": "1.57.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
