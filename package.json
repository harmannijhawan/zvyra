{
  "name": "zvyra",
  "productName": "ZVYRA",
  "version": "0.2.1",
  "description": "ZVYRA - your AI operating system. Windows-first personal AI agent with a persistent Dynamic Island.",
  "private": true,
  "author": "ZVYRA",
  "homepage": "https://zvyra.ai",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "electron-vite dev -- --mock-backend",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "start:mock": "electron-vite preview -- --mock-backend",
    "brand": "electron scripts/make-brand-assets.cjs",
    "dist": "npm --prefix backend run build && electron-vite build && electron-builder --win nsis --publish never",
    "dist:mac": "npm --prefix backend run build && electron-vite build && electron-builder --mac dmg zip --publish never",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "2.30.0",
    "@nut-tree-fork/nut-js": "4.2.6",
    "@runonflux/nat-upnp": "1.0.2",
    "diff": "9.0.0",
    "node-html-parser": "9.0.4",
    "playwright-core": "1.63.0",
    "qrcode": "1.5.4",
    "selfsigned": "5.5.0",
    "sherpa-onnx-node": "1.13.8",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "lucide-react": "1.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
